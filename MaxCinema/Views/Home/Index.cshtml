@model MaxCinema.Models.VM.QueryMovieListsVM


<h1>Welcome to Max Cinema</h1>
<br />

<body>
    <div class="container">
  
    
        <div id="movieCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/Images/hp600.jpeg" class="d-block w-100"
                         alt="HarryPotter">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Harry Potter and the Globel of Fire</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/transformers2.jpg" class="d-block w-100"
                         alt="Optimus-Prime">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Transformers</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/catchme860.jpg" class="d-block w-100"
                         alt="CatchMe">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Catch me if You can</h5>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#movieCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#movieCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        
    </div>
    }
        <div class="row mt-5">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top5.jpg" class="card-img-top" alt="Most Popular Movies">
                    <div class="card-body">
                        <h5 class="card-title">Most Popular Movies</h5>
                        <p class="card-text">The movies with the highest number of orders.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                @* ToDo: Make it so it goes to the detailed view of that movie *@
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[0].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[1].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[4].TitleAndYear</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top newest.jpg" class="card-img-top" alt="Newest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Newest Movies</h5>
                        <p class="card-text">Top 5 most recently released movies.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">@Model.Newest[0].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[1].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[4].TitleAndYear</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 newest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/classicTOP5.jpg" class="card-img-top" alt="Oldest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Oldest Movies</h5>
                        <p class="card-text">Top 5 oldest movies based on release year.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">@Model.Oldest[0].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Oldest[1].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Oldest[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Oldest[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Oldest[4].TitleAndYear</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 oldest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/cheapestTOP5.webp"card-img-top" alt="Cheapest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Cheapest Movies</h5>
                        <p class="card-text">Top 5 movies with the lowest prices.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">@Model.Cheapest[0].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Cheapest[1].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Cheapest[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Cheapest[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Cheapest[4].TitleAndYear</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 cheapest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/moneytopCustomer.jpg" class="card-img-top"
                         alt="Most Expensive Customer">
                    <div class="card-body">
                        <h5 class="card-title">Most Expensive Customer</h5>
                        <p class="card-text">The customer with the highest total order value.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Top Customer
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">@Model.BigestOrder.FullName</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top customer</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/cinemaHouse.jpg" class="card-img-top" alt="Our Cinema">
                    <div class="card-body">
                        <h5 class="card-title">Low-Fidelity</h5>
                        <p class="card-text">
                            Low-Fidelity Website Wireframes: Design Concept Preview
                        </p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Wireframes
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="~/Images/Home Page.png">Home Page</a></li>
                                <li><a class="dropdown-item" href="~/Images/About Us Page.png">About Us Page</a></li>
                                <li><a class="dropdown-item" href="~/Images/Cinema Library Page.png">Cinema Library Page</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 4</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted"> &copy; Max Cinema</small>
                    </div>
                </div>
            </div>

        </div>

    </div>
</body>



