            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/moneytopCustomer.jpg" class="card-img-top"
                         alt="Most Expensive Customer">
                    <div class="card-body">
                        <h5 class="card-title">Most Expensive Customer</h5>
                        <p class="card-text">The customer with the highest total order value.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart d-none d-sm-block">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Top Customer
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">@Model.BigestOrder.FullName</a></li>
                            </ul>
                        </div>
                        <!-- This Code is for Small Screens Accordion Above is for big Screens the list Drop Down Menu Button Just comment it for anyone knows -->
                        <div class="accordion d-block d-sm-none" id="accordionBigestOrderFullName">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingMovies">
                                    <button class="accordion-button bg-danger-subtle red-border" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMovies" aria-expanded="true" aria-controls="collapseMovies">
