                        </div>

                        <!-- This Code is for Small Screens Accordion Above is for big Screens the list Drop Down Menu Button Just comment it for anyone knows -->
                        <div class="accordion d-block d-sm-none" id="accordionOldestMovies">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingMovies">
                                    <button class="accordion-button bg-danger-subtle red-border" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMovies" aria-expanded="true" aria-controls="collapseMovies">
                                        Show Movies
                                    </button>
                                </h2>
                                <div id="collapseMovies" class="accordion-collapse collapse show" aria-labelledby="headingMovies" data-bs-parent="#accordionOldestMovies">
                                    <div class="accordion-body">
                                        <div class="glass-effect red-border bg-danger-subtle">
                                            <ul class="numbered-list">
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Oldest[0].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Oldest[1].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Oldest[2].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Oldest[3].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Oldest[4].TitleAndYear</a></li>
                                          </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <small class="text-muted">Top 5 oldest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/cheapestTOP5.webp"card-img-top" alt="Cheapest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Cheapest Movies</h5>
                        <p class="card-text">Top 5 movies with the lowest prices.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart d-none d-sm-block">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
