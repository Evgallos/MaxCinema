                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Newest[1].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Newest[2].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Newest[3].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Newest[4].TitleAndYear</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <small class="text-muted">Top 5 newest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/classicTOP5.jpg" class="card-img-top" alt="Oldest Movies">
                    <div class="card-body">
