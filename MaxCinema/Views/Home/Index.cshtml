                                <li><a class="dropdown-item" href="#">@Model.Newest[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="#">@Model.Newest[4].TitleAndYear</a></li>
                            </ul>
