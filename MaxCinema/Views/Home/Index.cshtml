
@model MaxCinema.Models.Movie
@using System.ComponentModel.DataAnnotations;
@using MaxCinema.Data;

@{

    ViewData["Title"] = "Welcome to Max Cinema";
}
<h1>@ViewData["Title"]</h1><br />

<body>
    <div class="btnAccess">
        <div class="position-absolute top-0 end-0 p-3 m-5">
            <a asp-controller="Customer" asp-action="CustomerCheckIn" class="btn btn-danger mb-3 box-shadow m-3" tabindex="-1" role="button" aria-disabled="true">Customer</a>
            <a href="Customer/DisplayAll" class="btn btn-primary mb-3 box-shadow m-3" tabindex="-1" role="button" aria-disabled="true">Admin</a>
        </div>
    </div>

    <div class="container">
        <div id="movieCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="@Model.Url" class="d-block w-100"
                         alt="@Model.Id">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@Model.Title</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="@Model.Url" class="d-block w-100"
                         alt="@Model.Id">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@Model.Title</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="@Model.Url" class="d-block w-100"
                         alt="@Model.Id">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@Model.Title</h5>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#movieCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#movieCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        
        <div class="row mt-5">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top5.jpg" class="card-img-top" alt="Most Popular Movies">
                    <div class="card-body">
                        <h5 class="card-title">Most Popular Movies</h5>
                        <p class="card-text">The movies with the highest number of orders.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Movie 1</a></li>
                                <li><a class="dropdown-item" href="#">Movie 2</a></li>
                                <li><a class="dropdown-item" href="#">Movie 3</a></li>
                                <li><a class="dropdown-item" href="#">Movie 4</a></li>
                                <li><a class="dropdown-item" href="#">Movie 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top newest.jpg" class="card-img-top" alt="Newest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Newest Movies</h5>
                        <p class="card-text">Top 5 most recently released movies.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Movie 1</a></li>
                                <li><a class="dropdown-item" href="#">Movie 2</a></li>
                                <li><a class="dropdown-item" href="#">Movie 3</a></li>
                                <li><a class="dropdown-item" href="#">Movie 4</a></li>
                                <li><a class="dropdown-item" href="#">Movie 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 newest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/classicTOP5.jpg" class="card-img-top" alt="Oldest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Oldest Movies</h5>
                        <p class="card-text">Top 5 oldest movies based on release year.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Movie 1</a></li>
                                <li><a class="dropdown-item" href="#">Movie 2</a></li>
                                <li><a class="dropdown-item" href="#">Movie 3</a></li>
                                <li><a class="dropdown-item" href="#">Movie 4</a></li>
                                <li><a class="dropdown-item" href="#">Movie 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 oldest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/cheapestTOP5.webp"card-img-top" alt="Cheapest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Cheapest Movies</h5>
                        <p class="card-text">Top 5 movies with the lowest prices.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Movie 1</a></li>
                                <li><a class="dropdown-item" href="#">Movie 2</a></li>
                                <li><a class="dropdown-item" href="#">Movie 3</a></li>
                                <li><a class="dropdown-item" href="#">Movie 4</a></li>
                                <li><a class="dropdown-item" href="#">Movie 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top 5 cheapest movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/moneytopCustomer.jpg" class="card-img-top"
                         alt="Most Expensive Customer">
                    <div class="card-body">
                        <h5 class="card-title">Most Expensive Customer</h5>
                        <p class="card-text">The customer with the highest total order value.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Top Customer
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Top Customer 1</a></li>
                            </ul>
                        </div>
                        <small class="text-muted">Top customer</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/cinemaHouse.jpg" class="card-img-top" alt="Our Cinema">
                    <div class="card-body">
                        <h5 class="card-title">Low-Fidelity</h5>
                        <p class="card-text">Low-Fidelity Wireframe picture of our website
                        </p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Wireframes
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <li><a class="dropdown-item" href="#">Wireframe 1</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 2</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 3</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 4</a></li>
                                <li><a class="dropdown-item" href="#">Wireframe 5</a></li>
                            </ul>
                        </div>
                        <small class="text-muted"> &copy; Max Cinema</small>
                    </div>
                </div>
            </div>

        </div>

    </div>
</body>


