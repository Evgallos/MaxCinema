@model IEnumerable<MaxCinema.Models.Customer>

@{
    ViewData["Title"] = "DisplayAll";
}


<h1>Admin Console </h1>
<h4>Create - Add - Edit - Customer</h4>
<div>
    <p>
        <a asp-action="CreateCustomer" class="btn btn-warning btn-sm box-shadow">Create New</a>
    </p>
</div>

<div class="btnAccess">
    <div class="position-absolute top-0 end-0 p-3 m-5">
        <a href="https://localhost:7022/Movie" class="btn btn-primary mb-3 box-shadow m-3" tabindex="-1" role="button" aria-disabled="true">Movie Editor</a>
    </div>
</div>
<div class="container mt-4">
    <div class="glass-effect red-border">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action mb-3 p-3 shadow-sm border rounded">
                <h5 class="mb-3"><strong>@Html.DisplayFor(modelItem => item.Firstname) @Html.DisplayFor(modelItem => item.Lastname)</strong></h5>
                <p><strong>Billing Address:</strong> @Html.DisplayFor(modelItem => item.BillingAddress), @Html.DisplayFor(modelItem => item.BillingCity), @Html.DisplayFor(modelItem => item.BillingZip)</p>
                <p><strong>Delivery Address:</strong> @Html.DisplayFor(modelItem => item.DeliveryAddress), @Html.DisplayFor(modelItem => item.DeliveryCity), @Html.DisplayFor(modelItem => item.DeliveryZip)</p>
                <p><strong>Email:</strong> @Html.DisplayFor(modelItem => item.EmailAddress)</p>
                <p><strong>Phone:</strong> @Html.DisplayFor(modelItem => item.Phone)</p>
                <div class="btn-group" role="group">
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-sm">Edit</a>
                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-sm">Details</a>
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm">Delete</a>
                </div>
            </div>
        }
    </div>
</div>
<div class="container mt-4">
    <div class="glass-effect red-border">
        @foreach (var item in Model)
        {
