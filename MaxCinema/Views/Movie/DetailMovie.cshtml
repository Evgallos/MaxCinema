@model MaxCinema.Models.Movie
@using System.ComponentModel.DataAnnotations;
@using MaxCinema.Data;

@{
    ViewData["Title"] = "DetailMovie";
}

<h1>@Model.TitleAndYear</h1>

<div class="container mt-5">

    <div class="row">
        <div class="col-md-4">
            <img src="@Model.Url" class="img-fluid" alt="@Model.Id">
        </div>
        <div class="col-md-8">
            <h3 class="text-center">@Model.Title</h3>
            <p class="text-center">This is a description of the movie>>> <!--Add something here via models--></p>

            <div class="text-center">
                <button onclick="AddToCart(@Model.Id)" type="button" class="btn btn-primary btn-md-3 box-shadow m-3">
                    <span class="glyphicon glyphicon-shopping-cart">
                    </span>
                    <b> Add to Cart </b>
                </button>
            </div>

            <div class="accordion mt-3" id="movieDetailsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            Movie Details
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#movieDetailsAccordion">
                        <div class="accordion-body">
                            <div class="list-unstyled">
                            <ul>
                                <li><strong>Director:</strong>@Model.Director</li>
                                <li><strong>Release Year:</strong>@Model.ReleaseYear</li>
                                <li><strong>Price:</strong>@Model.Price</li>
                            </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
