@model MaxCinema.Models.VM.QueryMovieListsVM


<h1>Welcome to Max Cinema</h1>
<br />

<body>
     
        <div class="btnAccess">
            <div class="position-absolute top-0 end-0 p-3 m-5">
                <a asp-controller="Customer" asp-action="CustomerCheckIn" class="btn btn-danger mb-3 box-shadow m-3" tabindex="-1" role="button" aria-disabled="true">Customer</a>
                <a href="Customer/DisplayAll" class="btn btn-primary mb-3 box-shadow m-3" tabindex="-1" role="button" aria-disabled="true">Admin</a>
            </div>
        </div>
    <div class="container">
  
    
        <div id="movieCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/Images/hp600.jpeg" class="d-block w-100"
                         alt="HarryPotter">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Harry Potter and the Globel of Fire</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/transformers2.jpg" class="d-block w-100"
                         alt="Optimus-Prime">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Transformers</h5>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/Images/catchme860.jpg" class="d-block w-100"
                         alt="CatchMe">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Catch me if You can</h5>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#movieCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#movieCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        
    </div>
    
        <div class="row mt-5">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top5.jpg" class="card-img-top" alt="Most Popular Movies">
                    <div class="card-body">
                        <h5 class="card-title">Most Popular Movies</h5>
                        <p class="card-text">The movies with the highest number of orders.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart d-none d-sm-block">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                @* ToDo: Make it so it goes to the detailed view of that movie *@
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[0].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[1].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[2].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[3].TitleAndYear</a></li>
                                <li><a class="dropdown-item" href="Movie">@Model.Mostpop[4].TitleAndYear</a></li>
                            </ul>
                        </div>

                        <!-- This Code is for Small Screens Accordion Above is for big Screens the list Drop Down Menu Button Just comment it for anyone knows -->
                        <div class="accordion d-block d-sm-none" id="accordionMostopopMovies">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingMovies">
                                    <button class="accordion-button bg-danger-subtle red-border" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMovies" aria-expanded="true" aria-controls="collapseMovies">
                                        Show Movies
                                    </button>
                                </h2>
                                <div id="collapseMovies" class="accordion-collapse collapse show" aria-labelledby="headingMovies" data-bs-parent="#accordionMostpopMovies">
                                    <div class="accordion-body">
                                        <div class="glass-effect red-border bg-danger-subtle">
                                            <ul class="numbered-list">
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Mostpop[0].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Mostpop[1].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Mostpop[2].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Mostpop[3].TitleAndYear</a></li>
                                                <li class="mb-3 p-sm-1 rounded shadow-sm icon-link hover-box body"><a href="#">@Model.Mostpop[4].TitleAndYear</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <small class="text-muted">Top 5 movies</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <img src="~/Images/top newest.jpg" class="card-img-top" alt="Newest Movies">
                    <div class="card-body">
                        <h5 class="card-title">Newest Movies</h5>
                        <p class="card-text">Top 5 most recently released movies.</p>
                    </div>
                    <div class="card-footer">
                        <div class="dropdown dropstart d-none d-sm-block">
                            <button class="btn btn-danger btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                Show Movies
