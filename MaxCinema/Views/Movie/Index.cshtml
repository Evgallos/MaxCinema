@model IEnumerable<MaxCinema.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Cinema Library</h1>

<p>
    <a asp-action="CreateMovie">Create New</a>
</p>
<div class="container">
    <div class="row mt-5">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <partial name="_DisplayMoviePartial" model="@item" />
            </div>
        }
    </div>
</div>


