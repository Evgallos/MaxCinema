

@model MaxCinema.Models.VM.QueryMovieListsVM

   
{
    <div class="family-font">Most Popular</div>
    <table class="table family-font">
        <tbody>
            @foreach (var item in Model.Mostpop)
            {
                <tr>
                    <td>
                        @item.Title
                    </td>
                    <td>
                        @item.Director
                    </td>
                    <td>
                        @item.ReleaseYear
                    </td>
                    <td>
                        @item.Price
                    </td>
                </tr>
            }
        </tbody>
    </table>

}

